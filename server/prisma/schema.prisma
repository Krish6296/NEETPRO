generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

enum TestType {
  FULL_MOCK
  CHAPTER
  SUBJECT
  PREVIOUS_YEAR
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  email         String?        @unique
  role          UserRole       @default(STUDENT)
  profile       Json           @default("{}")
  isBlocked     Boolean        @default(false) @map("is_blocked")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  attempts      TestAttempt[]
  otpChallenges OtpChallenge[]

  @@index([role, isBlocked])
  @@map("users")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([userId])
  @@map("otp_challenges")
}

model Question {
  id                String             @id @default(cuid())
  text              String
  imageUrl          String?            @map("image_url")
  options           Json
  correctOptionId   String             @map("correct_option_id")
  explanation       String?
  difficulty        QuestionDifficulty
  subject           String
  chapter           String
  tags              String[]           @default([])
  status            QuestionStatus     @default(DRAFT)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  testItems         TestQuestion[]
  answers           Answer[]
  questionSnapshots AttemptQuestion[]

  @@index([status, subject, chapter])
  @@index([difficulty])
  @@map("questions")
}

model Test {
  id              String         @id @default(cuid())
  name            String
  type            TestType
  durationMinutes Int            @map("duration_minutes")
  totalMarks      Int            @map("total_marks")
  negativeMarking Float          @default(1) @map("negative_marking")
  startTime       DateTime?      @map("start_time")
  endTime         DateTime?      @map("end_time")
  isLocked        Boolean        @default(false) @map("is_locked")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  questions       TestQuestion[]
  attempts        TestAttempt[]

  @@index([type, isLocked])
  @@index([startTime, endTime])
  @@map("tests")
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String   @map("test_id")
  questionId String   @map("question_id")
  position   Int
  marks      Int      @default(4)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testId, questionId])
  @@unique([testId, position])
  @@index([questionId])
  @@map("test_questions")
}

model TestAttempt {
  id                String            @id @default(cuid())
  studentId         String            @map("student_id")
  testId            String            @map("test_id")
  status            AttemptStatus     @default(IN_PROGRESS)
  startedAt         DateTime          @default(now()) @map("started_at")
  submittedAt       DateTime?         @map("submitted_at")
  totalScore        Float?            @map("total_score")
  rank              Int?
  student           User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  test              Test              @relation(fields: [testId], references: [id], onDelete: Restrict)
  answers           Answer[]
  questionSnapshots AttemptQuestion[]

  @@index([studentId, status])
  @@index([testId, status, totalScore])
  @@map("test_attempts")
}

model AttemptQuestion {
  id              String      @id @default(cuid())
  attemptId       String      @map("attempt_id")
  questionId      String      @map("question_id")
  position        Int
  marks           Int         @default(4)
  text            String
  options         Json
  correctOptionId String      @map("correct_option_id")
  explanation     String?
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
  @@map("attempt_questions")
}

model Answer {
  id                String      @id @default(cuid())
  attemptId         String      @map("attempt_id")
  questionId        String      @map("question_id")
  selectedOptionId  String?     @map("selected_option_id")
  timeSpent         Int         @default(0) @map("time_spent")
  isMarkedForReview Boolean     @default(false) @map("is_marked_for_review")
  isCorrect         Boolean?    @map("is_correct")
  attempt           TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([attemptId])
  @@map("answers")
}
